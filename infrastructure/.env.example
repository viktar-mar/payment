# Local development examples only. Change both passwords before any non-local deployment.
PAYMENT_DB_PASSWORD=local-payment-password
PAYMENT_ADMIN_BOOTSTRAP_USERNAME=admin
PAYMENT_ADMIN_BOOTSTRAP_PASSWORD=change-this-local-password
# Keep localhost binding; use 5433 if another local database already owns 5432.
PAYMENT_POSTGRES_HOST_PORT=5432
# Local development ONLY. Never reuse this public example key outside local development.
PAYMENT_DATA_ENCRYPTION_KEY=bG9jYWwtZGV2LXBheW1lbnQta2V5LTMyLWJ5dGVzISE=
PAYMENT_DATA_ENCRYPTION_KEY_VERSION=local-v1
# Public local-only HMAC key, distinct from the encryption key. Retain for durable checkout replay.
PAYMENT_DONATION_MESSAGE_FINGERPRINT_KEY=bG9jYWwtZG9uYXRpb24taG1hYy1rZXktMzItYnl0ZXM=
PAYMENT_DONATION_MESSAGE_FINGERPRINT_VERSION=v1
# Public examples ONLY, never reuse in production. Startup validation still requires explicit keys.
PAYMENT_CUSTOMER_DIGEST_KEY_V1=bG9jYWwtY3VzdG9tZXItZGlnZXN0LWtleS0zMmJ5dGU=
PAYMENT_CUSTOMER_DIGEST_ACTIVE_VERSION=v1
PAYMENT_CUSTOMER_HISTORY_CURSOR_KEY_V1=bG9jYWwtaGlzdG9yeS1jdXJzb3Ita2V5LTMyLWJ5dGU=
PAYMENT_CUSTOMER_HISTORY_CURSOR_ACTIVE_VERSION=v1
PAYMENT_MAILPIT_HOST_PORT=28025
PAYMENT_MAILPIT_SMTP_HOST_PORT=21025
PAYMENT_FAKE_AUTO_SUCCESS=false
# Finite deployed Site-key labels: add each Site key before creating its first Payment.
PAYMENT_TELEMETRY_SITEKEYS=demo
PAYMENT_BACKEND_HOST_PORT=8080
PAYMENT_ADMIN_HOST_PORT=3000
PAYMENT_DEMO_HOST_PORT=3001
