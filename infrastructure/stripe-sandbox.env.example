# заполнить локально; не передавать в чат
PAYMENT_STRIPE_SANDBOX_SECRET_KEY=
PAYMENT_STRIPE_SANDBOX_PUBLISHABLE_KEY=
PAYMENT_STRIPE_SANDBOX_WEBHOOK_SECRET=

# Stage 5B Billing browser actions: disabled unless explicitly provisioned.
# Dedicated secret-management input; never reuse any provider/identity/encryption key.
# Pass explicitly to the backend; existing bootstrap/Compose scripts do not provision it.
PAYMENT_STRIPE_BILLING_ACTIONS_ENABLED=false
# PAYMENT_STRIPE_BILLING_ACTIONS_ACTIVE_KEY_VERSION=v1
# PAYMENT_STRIPE_BILLING_ACTIONS_KEY_VERSIONS=v1
# PAYMENT_STRIPE_BILLING_ACTIONS_KEY_V1=<Base64 of a dedicated random 32-byte key>
# Format, rotation and API contract: docs/stripe-billing-client-sessions.md
