# Dedicated image for the explicitly admitted optional-trial scenario.
FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline
COPY src/main ./src/main
# Compile only the fixture sources exported below. The ordinary test build still uses all of src/test.
COPY src/test/java/dev/genericpayments/acceptance/runtime/OwnedBillingOptionalTrialRuntime.java \
     src/test/java/dev/genericpayments/acceptance/runtime/OwnedBillingOptionalTrialScenario.java \
     ./src/test/java/dev/genericpayments/acceptance/runtime/
COPY src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/JdbcOwnedOptionalTrialCreateStore.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialAcceptance.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialAdmission.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialClockAdvance.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialCreate.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialPaymentConfirmation.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialPublication.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialResume.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialResumeGraph.java \
     src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/OwnedOptionalTrialSetup.java \
     ./src/test/java/dev/genericpayments/platform/provider/adapter/out/stripe/billing/
COPY src/test/java/dev/genericpayments/platform/support/OwnedSubscriptionBillingTime.java \
     ./src/test/java/dev/genericpayments/platform/support/
COPY src/test/resources/db/owned-optional-trial/ ./src/test/resources/db/owned-optional-trial/
COPY export-billing-optional-trial-runtime.sh ./
RUN mvn -B -ntp -DskipTests package \
    && mvn -B -ntp dependency:copy-dependencies -DincludeArtifactIds=spring-boot-test \
        -DincludeScope=test -DoutputDirectory=/workspace/optional-trial-libs \
    && sh export-billing-optional-trial-runtime.sh /workspace/target/test-classes /workspace/optional-trial-runtime \
    && set -- /workspace/optional-trial-libs/spring-boot-test-*.jar && [ "$#" -eq 1 ] && [ -f "$1" ]

FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 payment && useradd --uid 10001 --gid payment --no-create-home payment
ARG PAYMENT_RUNTIME_SOURCE_SHA
ENV PAYMENT_RUNTIME_SOURCE_SHA=${PAYMENT_RUNTIME_SOURCE_SHA}
WORKDIR /app
COPY --from=build --chown=payment:payment /workspace/target/payment-platform-backend-*.jar app.jar
COPY --from=build --chown=payment:payment /workspace/optional-trial-runtime /app/optional-trial-runtime
COPY --from=build --chown=payment:payment /workspace/optional-trial-libs/spring-boot-test-*.jar /app/optional-trial-libs/
USER payment
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=300s --retries=12 \
  CMD curl --fail --silent --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8080/actuator/health/readiness
ENTRYPOINT ["java", "-Dloader.path=/app/optional-trial-runtime,/app/optional-trial-libs", "-Dloader.main=dev.genericpayments.acceptance.runtime.OwnedBillingOptionalTrialRuntime", "-cp", "/app/app.jar", "org.springframework.boot.loader.launch.PropertiesLauncher"]
