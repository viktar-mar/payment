# Dedicated future owned failed-renewal lane; no default-image selection.
FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline
COPY src ./src
COPY export-billing-failed-renewal-runtime.sh ./
RUN mvn -B -ntp -DskipTests package \
    && sh export-billing-failed-renewal-runtime.sh /workspace/target/test-classes /workspace/failed-renewal-runtime

FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 payment && useradd --uid 10001 --gid payment --no-create-home payment
ARG PAYMENT_RUNTIME_SOURCE_SHA
ENV PAYMENT_RUNTIME_SOURCE_SHA=${PAYMENT_RUNTIME_SOURCE_SHA}
WORKDIR /app
COPY --from=build --chown=payment:payment /workspace/target/payment-platform-backend-*.jar app.jar
COPY --from=build --chown=payment:payment /workspace/failed-renewal-runtime /app/failed-renewal-runtime
USER payment
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=300s --retries=12 \
  CMD curl --fail --silent --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8080/actuator/health/readiness
ENTRYPOINT ["java", "-Dloader.path=/app/failed-renewal-runtime", "-Dloader.main=dev.genericpayments.acceptance.runtime.OwnedBillingFailedRenewalRuntime", "-cp", "/app/app.jar", "org.springframework.boot.loader.launch.PropertiesLauncher"]
